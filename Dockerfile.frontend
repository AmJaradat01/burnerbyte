# ── Dependency stage ──
# pnpm-workspace.yaml must be copied alongside the manifest: it carries the
# build-script policy, and without it pnpm 10+ aborts with ERR_PNPM_IGNORED_BUILDS.
# The pnpm version itself comes from the "packageManager" field via corepack, so
# the image installs exactly the pnpm that produced pnpm-lock.yaml.
FROM node:22-alpine AS deps
WORKDIR /app
RUN corepack enable
COPY web/package.json web/pnpm-lock.yaml web/pnpm-workspace.yaml ./
# --ignore-scripts because this stage has the manifest but not the source: the
# postinstall runs fumadocs-mdx, which needs source.config.ts and fails without
# it. The builder stage regenerates .source during `pnpm build` regardless, so
# nothing is lost by skipping it here.
RUN pnpm install --frozen-lockfile --ignore-scripts

# ── Build stage ──
FROM node:22-alpine AS builder
WORKDIR /app
RUN corepack enable
COPY --from=deps /app/node_modules ./node_modules
COPY web/ .
# NEXT_PUBLIC_* are inlined into the client bundle at build time, so they must be
# build args, not runtime env. Defaults target a localhost compose stack; override
# via the frontend service's build.args for other hosts.
ARG NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
ARG NEXT_PUBLIC_WS_URL=ws://localhost:8080/api/v1/ws
ARG NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Where the "Docs" links point. The documentation is published at
# burnerbyte.com/docs from this repo's web/content/docs; override this to a
# mirror you host if the deployment has no outbound internet.
ARG NEXT_PUBLIC_DOCS_URL=https://burnerbyte.com/docs
ENV NEXT_PUBLIC_DOCS_URL=$NEXT_PUBLIC_DOCS_URL \
    NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_WS_URL=$NEXT_PUBLIC_WS_URL \
    NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL
ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm build

# ── Runtime stage ──
# next.config.mjs sets output: 'standalone', so the server and its pruned
# node_modules come from .next/standalone; static assets and public/ are copied
# next to it because standalone does not bundle them.
FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs
COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
USER nextjs
EXPOSE 3000
ENV PORT=3000 HOSTNAME=0.0.0.0
CMD ["node", "server.js"]
