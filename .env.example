# BurnerByte Environment Variables
# Copy this file to .env and fill in your values
# All BB_ prefixed vars map to config.yaml keys (e.g. BB_SERVER_PORT → server.port)

# ── Database ──
# Used when running the binaries directly (make run-api / make run-smtp). Docker
# Compose does NOT read this: inside a container "localhost" is the container
# itself, so compose builds its own DSN pointing at the bundled postgres service.
DATABASE_URL=postgres://postgres:password@localhost:5432/burnerbyte?sslmode=disable

# To point the Docker stack at a managed database instead of the bundled
# containers, set these. api, smtpd and the one-shot migrate job all honour them,
# and the bundled postgres/redis simply go unused.
# EXTERNAL_DATABASE_URL=postgres://user:pass@db.example.com:5432/burnerbyte?sslmode=require
# EXTERNAL_REDIS_URL=rediss://:password@cache.example.com:6380

# ── Redis ──
REDIS_URL=redis://localhost:6379/0
BB_REDIS_MAX_RETRIES=3

# ── Connection pool ──
BB_DATABASE_MAX_OPEN_CONNS=25
BB_DATABASE_MAX_IDLE_CONNS=5
BB_DATABASE_CONN_MAX_LIFETIME=5m

# ── MinIO / S3 ──
# Leave BB_MINIO_ENDPOINT empty to store attachments on the local filesystem
# (./data/attachments). localhost:9000 is what `make docker-infra` starts; an
# endpoint that is set but unreachable costs a dial timeout on every boot before
# falling back, so clear it rather than leaving a stale value.
BB_MINIO_ENDPOINT=localhost:9000
BB_MINIO_ACCESS_KEY=minioadmin
BB_MINIO_SECRET_KEY=minioadmin
BB_MINIO_BUCKET=burnerbyte
BB_MINIO_USE_SSL=false

# ── Docker Compose Overrides ──
# These only apply when running via docker-compose. JWT_SECRET, ENCRYPTION_KEY,
# API_BASE_URL and FRONTEND_URL (defined elsewhere in this file) are also read by
# compose. NEXT_PUBLIC_* are baked into the frontend at build time, so changing
# API_BASE_URL / WS_BASE_URL requires rebuilding the frontend image.
# POSTGRES_USER=burnerbyte
# POSTGRES_PASSWORD=burnerbyte
# POSTGRES_DB=burnerbyte
# POSTGRES_PORT=5432
# REDIS_PASSWORD=burnerbyte-redis
# REDIS_PORT=6379
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin
# MINIO_BUCKET=burnerbyte
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001
# API_PORT=8080
# SMTPD_PORT=2525                     # set to 25 to receive real inbound mail
# SMTP_HOSTNAME=mail.burnerbyte.local
# FRONTEND_PORT=3000
# WS_BASE_URL=ws://localhost:8080     # use wss://your-host for TLS deployments
# CORS_ALLOWED_ORIGINS=https://app.example.com   # CORS + WebSocket; defaults to FRONTEND_URL, comma-separate for multiple

# ── JWT ──
# The API refuses to start on this placeholder — generate a real one:
#   openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-64-char-string
BB_JWT_ACCESS_TTL=15m
BB_JWT_REFRESH_TTL=168h

# ── SMTP Inbound ──
BB_SMTP_LISTEN=0.0.0.0:2525
BB_SMTP_HOSTNAME=mail.example.com
BB_SMTP_MAX_SIZE=26214400
BB_SMTP_QUEUE_SIZE=1000
BB_SMTP_WORKERS=4
# Set both to enable STARTTLS on the inbound listener.
BB_SMTP_TLS_CERT=
BB_SMTP_TLS_KEY=

# ── Mailer (outbound SMTP sender) ──
BB_MAILER_HOST=smtp.example.com
BB_MAILER_PORT=587
BB_MAILER_USERNAME=
BB_MAILER_PASSWORD=
BB_MAILER_FROM=noreply@example.com
BB_MAILER_TLS=true

# ── SSO / OIDC ──
BB_SSO_PROVIDER=
BB_SSO_CLIENT_ID=
BB_SSO_CLIENT_SECRET=
BB_SSO_REDIRECT_URL=http://localhost:8080/api/v1/auth/sso/callback
BB_SSO_TENANT_ID=                   # azure
BB_SSO_ISSUER_URL=                  # okta / generic OIDC discovery
BB_SSO_AUTO_PROVISION=false         # give first-time SSO users an org membership
BB_SSO_DEFAULT_ORG_ROLE=
BB_SSO_DEFAULT_TEAM_ROLE=
BB_SSO_ALLOWED_DOMAINS=             # comma-separated; empty allows any

# ── Server ──
API_PORT=8080
API_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
BB_SERVER_READ_TIMEOUT=30s
BB_SERVER_WRITE_TIMEOUT=30s
BB_SERVER_IDLE_TIMEOUT=120s
BB_SERVER_SHUTDOWN_TIMEOUT=15s
BB_SERVER_MAX_BODY_SIZE=1048576

# ── CORS ──
BB_CORS_ALLOWED_ORIGINS=http://localhost:3000
BB_CORS_MAX_AGE=86400
BB_CORS_ALLOWED_METHODS=GET,POST,PATCH,PUT,DELETE,OPTIONS
BB_CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Request-ID

# ── Auth cookie ──
# lax (default) | strict | none. "none" forces Secure and therefore HTTPS —
# use it only when the frontend and API sit on unrelated domains.
BB_AUTH_COOKIE_SAME_SITE=lax

# ── Rate Limiting ──
BB_RATE_LIMIT_ENABLED=true
# Deliberately tighter than the built-in defaults (300 / 60 / 10). Raise them to
# match config.example.yaml if copying this file should not change your limits.
BB_RATE_LIMIT_AUTHENTICATED=100
BB_RATE_LIMIT_UNAUTHENTICATED=20
BB_RATE_LIMIT_LOGIN=5
BB_RATE_LIMIT_FORGOT_PASSWORD=3      # per hour, unlike the others
# CIDRs (a bare IP is treated as /32) whose X-Forwarded-For is trusted.
BB_RATE_LIMIT_TRUSTED_PROXIES=

# ── Account Lockout ──
BB_LOCKOUT_MAX_ATTEMPTS=5
BB_LOCKOUT_DURATION=15m

# ── Password Policy ──
BB_PASSWORD_POLICY_MIN_LENGTH=8
BB_PASSWORD_POLICY_REQUIRE_UPPERCASE=true
BB_PASSWORD_POLICY_REQUIRE_LOWERCASE=true
BB_PASSWORD_POLICY_REQUIRE_NUMBER=true
BB_PASSWORD_POLICY_REQUIRE_SPECIAL=true
BB_PASSWORD_POLICY_BCRYPT_COST=10

# ── Defaults ──
BB_DEFAULTS_ATTACHMENTS_ENABLED=true
BB_DEFAULTS_ALLOW_REGISTRATION=true
BB_DEFAULTS_DEFAULT_INBOX_TTL=10m
BB_DEFAULTS_MAX_INBOX_TTL=24h
BB_DEFAULTS_MAX_ATTACHMENT_SIZE_MB=25
BB_DEFAULTS_MAX_DOMAINS=10
BB_DEFAULTS_MAX_TEAMS=50
BB_DEFAULTS_MAX_INBOXES_PER_DOMAIN=100
BB_DEFAULTS_ENFORCE_SSO=false
BB_DEFAULTS_PASSWORD_RESET_TTL=1h
BB_DEFAULTS_INVITE_EXPIRY_TTL=48h
BB_DEFAULTS_PRESIGNED_URL_TTL=15m
BB_DEFAULTS_WEBHOOK_TIMEOUT=10s
BB_DEFAULTS_ANALYTICS_CACHE_TTL=2h
BB_DEFAULTS_MAX_SESSIONS_PER_USER=5
BB_DEFAULTS_WEBHOOK_MAX_RETRIES=3
BB_DEFAULTS_ANALYTICS_DEFAULT_DAYS=30
BB_DEFAULTS_TIMEZONE=UTC
BB_DEFAULTS_DATE_FORMAT=YYYY-MM-DD
BB_DEFAULTS_TIME_FORMAT=24h

# ── Email Verification ──
BB_EMAIL_VERIFICATION_ENABLED=true
BB_EMAIL_VERIFICATION_TTL=24h

# ── Public demo ("try it") inbox — off by default ──
DEMO_ENABLED=false
DEMO_ASSIGNMENT_ID=                 # a domain assignment the demo user's team owns
DEMO_USER_ID=                       # the account that owns demo inboxes
DEMO_TTL=10m

# ── Logging ──
LOG_LEVEL=debug
LOG_FORMAT=json

# ── Metrics ──
BB_METRICS_ENABLED=true
BB_METRICS_PATH=/metrics
# When set, /metrics also requires "Authorization: Bearer <token>". The
# loopback/private-address check alone relies on your proxy overwriting inbound
# X-Forwarded-For and X-Real-IP; a token does not rely on anyone's proxy
# config. Prometheus reads it via scrape_config.bearer_token.
BB_METRICS_TOKEN=

# ── Security switches ──
# Re-enables "?token=<jwt>" on the WebSocket endpoints. The browser client uses
# the one-time ?ticket= flow; a token in a URL lands in proxy access logs and
# browser history. Turn on only if a non-browser client still needs it.
BB_SECURITY_ALLOW_TOKEN_QUERY_PARAM=false
# Refuse password logins until the address is confirmed. Off by default:
# enabling it on an existing deployment locks out every account created before
# verification was enforced.
BB_SECURITY_REQUIRE_EMAIL_VERIFICATION=false

# ── Workers ──
BB_WORKERS_DNS_RECHECK_INTERVAL=1h
BB_WORKERS_CLEANUP_INTERVAL=5m
BB_WORKERS_WEBHOOK_RETRY_INTERVAL=1m
BB_WORKERS_RECONCILER_INTERVAL=1m
BB_WORKERS_ANALYTICS_INTERVAL=5m

# ── Encryption (AES-256-GCM for sensitive DB values) ──
# Generate with: openssl rand -hex 32. Unprefixed (not BB_): read by the binary
# directly and by docker-compose. When empty, secrets are stored UNENCRYPTED.
ENCRYPTION_KEY=
