# BurnerByte Environment Variables
# Copy this file to .env and fill in your values

# ── Database ──
DATABASE_URL=postgres://burnerbyte:burnerbyte@localhost:5432/burnerbyte?sslmode=disable

# ── Redis ──
REDIS_URL=redis://localhost:6379/0

# ── MinIO / S3 ──
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=burnerbyte
MINIO_USE_SSL=false

# ── JWT ──
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# ── SMTP Inbound (go-guerrilla) ──
SMTP_LISTEN=0.0.0.0:2525
SMTP_HOSTNAME=mail.example.com
SMTP_MAX_SIZE=26214400

# ── Mailer (outbound SMTP sender) ──
MAILER_HOST=smtp.example.com
MAILER_PORT=587
MAILER_USERNAME=
MAILER_PASSWORD=
MAILER_FROM=noreply@example.com
MAILER_TLS=true

# ── SSO / OIDC ──
SSO_PROVIDER=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URL=http://localhost:8080/api/v1/auth/sso/callback

# ── Server ──
API_PORT=8080
API_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

# ── Logging ──
LOG_LEVEL=debug
LOG_FORMAT=json
