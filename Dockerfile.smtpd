# NOTE: This standalone smtpd image is superseded by the multi-stage Dockerfile's
# `smtpd` target, which docker-compose builds. It is kept only for standalone
# `docker build -f Dockerfile.smtpd` use and is otherwise redundant. The binary
# boots from environment variables, so no config.yaml is copied (see Dockerfile).
FROM golang:1.25-alpine3.23 AS builder
RUN apk add --no-cache git
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /bin/smtpd ./cmd/smtpd

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata && adduser -D -H appuser
COPY --from=builder /bin/smtpd /usr/local/bin/smtpd
USER appuser
EXPOSE 2525
ENTRYPOINT ["smtpd"]
