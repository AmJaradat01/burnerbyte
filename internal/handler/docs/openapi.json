          "200": {
            "description": "Sessions list"
          }
        }
      },
      "delete": {
        "tags": [
          "Sessions"
        ],
        "summary": "Revoke all sessions",
        "responses": {
          "200": {
            "description": "All sessions revoked"
          }
        }
      }
    },
    "/auth/sessions/{sessionId}": {
      "delete": {
        "tags": [
          "Sessions"
        ],
        "summary": "Revoke a session",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Session revoked"
          }
        }
      }
    },
